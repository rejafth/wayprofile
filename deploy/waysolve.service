[Unit]
Description=Website Waysolve (Flask + gunicorn)
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/opt/waysolve
EnvironmentFile=/opt/waysolve/.env
ExecStart=/opt/waysolve/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:8000 --access-logfile - app:app
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
